# Initial profile for the confirmed Alibaba Cloud Linux 3 / x86_64 / 2 GiB host.
# Merge these settings into the existing Taffy .env; keep model/API settings.
# Create and verify the taffy-aliyun SSH Docker context before starting Taffy.
SANDBOX_MODE=docker
SANDBOX_IMAGE=taffy-sandbox:1
SANDBOX_DOCKER_CONTEXT=taffy-aliyun
SANDBOX_CPUS=0.5
SANDBOX_MEMORY_MB=512
SANDBOX_PIDS=64
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_WORKSPACE_MB=128
SANDBOX_TRANSFER_MB=64
