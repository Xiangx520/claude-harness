ANTHROPIC_API_KEY=your-api-key
MODEL_ID=your-model-id

# Optional: a compatible API endpoint and a fallback model.
# ANTHROPIC_BASE_URL=https://your-api-endpoint
# FALLBACK_MODEL_ID=your-fallback-model-id
# Transient failures use bounded retries, then this fallback for the current query.
# Sessions are checkpointed locally in .sessions/; use /session list|resume <id>|continue.

# Optional: a separate model for goal completion evaluation (defaults to MODEL_ID).
# GOAL_EVALUATOR_MODEL_ID=your-evaluator-model-id
# Optional: limit worker model turns per query, including automatic continuation.
# MAX_TURNS=20
# Goal Stop hook continuation cap per query (default: 8).
# GOAL_STOP_HOOK_BLOCK_CAP=8

# CLI defaults to Docker isolation. "disabled" explicitly allows host execution.
SANDBOX_MODE=docker
SANDBOX_IMAGE=taffy-sandbox:1
# An SSH Docker context may be selected for a remote Linux server.
SANDBOX_DOCKER_CONTEXT=default
# Optional: absolute Docker CLI path, including paths containing spaces.
# SANDBOX_DOCKER_EXECUTABLE=C:/Users/your-name/.taffy/bin/docker.exe
SANDBOX_CPUS=1
SANDBOX_MEMORY_MB=1024
SANDBOX_PIDS=128
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_WORKSPACE_MB=512
SANDBOX_TRANSFER_MB=128

# Child agents: persistent teammates include idle and approval-waiting workers.
MAX_TEAMMATES=3
# Model turns per task call or teammate activation; idle waiting does not count.
WORKER_MAX_TURNS=30
# Worker progress lease; slow API calls exceeding this duration are fenced.
WORKER_LEASE_SECONDS=300
